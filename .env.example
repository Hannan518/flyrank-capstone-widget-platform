# Copy to .env and adjust. NEVER commit the real .env.
APP_ENV=dev

DATABASE_URL=postgresql+asyncpg://widget:widget@localhost:5432/widget_platform

JWT_SECRET=change-me-min-32-chars-dev-only-secret!!
JWT_TTL_HOURS=24

PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=[]

SUBMISSION_MAX_BODY_BYTES=65536

RATE_LIMIT_IP_MAX=5
RATE_LIMIT_IP_WINDOW_SECONDS=60
RATE_LIMIT_WIDGET_MAX=100
RATE_LIMIT_WIDGET_WINDOW_SECONDS=60
RATE_LIMIT_RETENTION_SECONDS=7200

GEO_PROVIDER_MODE=live
GEO_TOTAL_BUDGET_MS=2000
DEV_PUBLIC_IP=8.8.8.8

EMAIL_MODE=console
JOBS_POLL_INTERVAL_SECONDS=2
JOB_RETENTION_DAYS=7
